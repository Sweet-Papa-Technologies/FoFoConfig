#!/bin/sh
# fofoconfig — thin Hermes launcher with config-task subcommands.
# See docs/Requirements-Specs.md §7-§8 and docs/design.plan.md §6.2.
set -eu

export HERMES_HOME="${HERMES_HOME:-$HOME/.fofoconfig}"
export HERMES_REDACT_SECRETS=true     # belt-and-braces with config.yaml security.redact_secrets

# Repo dir is baked in by install.sh (sed-replaces @FOFO_REPO_DIR@).
# We can't compare to the sentinel here because sed would substitute that too,
# so detect-via-existence instead: if scripts/ isn't where we expect, fall back.
FOFO_REPO_DIR="@FOFO_REPO_DIR@"
[ -d "$FOFO_REPO_DIR/scripts" ] || FOFO_REPO_DIR="$HOME/.fofoconfig-src"

# Helper: refuse to launch a session if the operator hasn't configured an endpoint yet.
check_setup() {
  if [ ! -f "$HERMES_HOME/config.yaml" ] || \
     grep -q '^  default: PLEASE_RUN_FOFOCONFIG_SETUP' "$HERMES_HOME/config.yaml" 2>/dev/null; then
    printf '\033[1;33m[fofo]\033[0m No endpoint configured yet. Run: fofoconfig setup\n' >&2
    exit 2
  fi
}

cmd="${1:-}"; [ $# -gt 0 ] && shift

case "$cmd" in
  ""|"chat")
    check_setup
    exec hermes chat ;;                                       # interactive TUI
  "setup")
    exec "$FOFO_REPO_DIR/scripts/fofoconfig-setup.sh" "$@" ;;
  "resume")
    check_setup
    if [ -n "${1:-}" ]; then exec hermes --resume "$1"
    else exec hermes --continue; fi ;;
  "edit")
    check_setup
    [ -n "${1:-}" ] || { echo "usage: fofoconfig edit <program-or-path>"; exit 2; }
    printf '\033[1;34m[fofo]\033[0m Tip: ask me — "edit the configuration for: %s"\n' "$*"
    exec hermes chat ;;                                       # interactive — confirm gate works
  "explain")
    check_setup
    [ -n "${1:-}" ] || { echo "usage: fofoconfig explain <path>"; exit 2; }
    printf '\033[1;34m[fofo]\033[0m Tip: ask me — "explain this config file: %s"\n' "$*"
    exec hermes chat ;;
  "doctor")
    exec "$FOFO_REPO_DIR/scripts/smoke-tests.sh" ;;
  "-h"|"--help"|"help")
    cat <<'EOF'
fofoconfig — privacy-first config-file specialist (BYO Gemma 4 endpoint)

USAGE:
  fofoconfig setup          Configure endpoint URL / model / API key (interactive wizard)
  fofoconfig                Start interactive TUI
  fofoconfig edit <prog>    Print a tip, then start interactive TUI (so the confirm gate works)
  fofoconfig explain <path> Print a tip, then start interactive TUI
  fofoconfig resume [id]    Resume last session (CLI flag --continue/--resume)
  fofoconfig doctor         Run step-zero smoke tests against the configured endpoint

FIRST RUN:
  1. fofoconfig setup       # tell FoFoConfig where your Gemma 4 endpoint is
  2. fofoconfig             # start chatting

ENV:
  HERMES_HOME  (default: ~/.fofoconfig)
EOF
    ;;
  *) check_setup; exec hermes chat ;;
esac
